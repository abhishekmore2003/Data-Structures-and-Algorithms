# You are given a sorted array of integers and a target.
# Find the two numbers whose sum equals the target and return their indices.

numbers = [1, 3, 4, 6, 8, 10]
target = 14

def findIndex(numbers,target) :
    left = 0 
    right = len(numbers) - 1

    while left < right :
        if numbers[left] + numbers[right] > target :
            right -= 1
        elif numbers[left] + numbers[right] < target :
            left += 1
        else :
            return left,right
    return "no any index found"
    

result = findIndex(numbers,target)
print(result)



